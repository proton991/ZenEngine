include("${CMAKE_CURRENT_LIST_DIR}/LatestSubprojects.cmake")
set(ZEN_RHI_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../ZenRHI" CACHE PATH "ZenRHI source checkout")
option(ZEN_RHI_USE_INSTALLED "Use an installed ZenRHI package" OFF)
if(ZEN_RHI_USE_INSTALLED)
    set(ZEN_RHI_RELEASE ${ZenEngine_VERSION_MAJOR}.${ZenEngine_VERSION_MINOR})
    if(BUILD_TESTING)
        find_package(ZenRHI ${ZEN_RHI_RELEASE} CONFIG REQUIRED COMPONENTS TestSupport)
    else()
        find_package(ZenRHI ${ZEN_RHI_RELEASE} CONFIG REQUIRED)
    endif()
    get_target_property(ZEN_RHI_INCLUDE_DIR ZenRHI::Core INTERFACE_INCLUDE_DIRECTORIES)
    set(ZEN_RHI_VERSION "${ZenRHI_VERSION}")
else()
    zen_update_subproject_checkout(ZenRHI "${ZEN_RHI_SOURCE_DIR}")
    add_subdirectory("${ZEN_RHI_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/ZenRHI")
    set(ZEN_RHI_INCLUDE_DIR "${ZEN_RHI_SOURCE_DIR}/include")
    zen_source_version(ZEN_RHI_VERSION "${ZEN_RHI_SOURCE_DIR}")
endif()
zen_require_release_version(ZenRHI "${ZEN_RHI_VERSION}")
