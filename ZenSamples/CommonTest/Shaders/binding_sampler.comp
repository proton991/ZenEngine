#version 450
layout(local_size_x = 1) in;
layout(set = 1, binding = 0) uniform sampler expectedSampler;
layout(set = 1, binding = 1) uniform texture2D inputTexture;
layout(set = 1, binding = 2, std430) buffer Result { uint color; } result;
void main()
{
    result.color = packUnorm4x8(texture(sampler2D(inputTexture, expectedSampler), vec2(0.5)));
}
