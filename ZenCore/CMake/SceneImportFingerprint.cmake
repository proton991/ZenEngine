# Writes a header naming the content hash of every source that shapes imported
# scene assets. Automatic caches include it in their key, so editing an importer,
# decoder or the internal format invalidates caches without a manual version bump.
# Usage: cmake -DOUTPUT=<header> -DINPUT_LIST=<file listing inputs> -P SceneImportFingerprint.cmake
file(STRINGS "${INPUT_LIST}" inputs)
list(SORT inputs)
set(combined "")
foreach (input IN LISTS inputs)
    if (EXISTS "${input}")
        file(SHA256 "${input}" digest)
        get_filename_component(name "${input}" NAME)
        string(APPEND combined "${name}:${digest};")
    endif ()
endforeach ()
string(SHA256 fingerprint "${combined}")
set(content "#pragma once\n// Generated by ZenCore/CMake/SceneImportFingerprint.cmake. Do not edit.\n#define ZEN_SCENE_IMPORT_FINGERPRINT \"${fingerprint}\"\n")
set(previous "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif ()
if (NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif ()
