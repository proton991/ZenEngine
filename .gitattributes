# Every checkout gets exactly the committed bytes on Windows, macOS and Linux.
# Text is LF in the repository and in every working tree, whatever a machine's
# core.autocrlf or core.eol says; a CRLF file is normalized to LF when added.
* text=auto eol=lf

# cmd.exe misreads labels in LF batch files, so these are committed with CRLF
# and never converted.
*.bat -text
*.cmd -text

# Never convert binary assets, even when their first bytes look like text.
*.bin binary
*.dds binary
*.exr binary
*.gif binary
*.glb binary
*.hdr binary
*.icns binary
*.ico binary
*.jpeg binary
*.jpg binary
*.ktx binary
*.ktx2 binary
*.otf binary
*.pdf binary
*.png binary
*.spv binary
*.ttf binary
*.zenasset binary
