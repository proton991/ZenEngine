#version 450
#extension GL_GOOGLE_include_directive : require
#include "environment_distribution.glsl"
layout(local_size_x=64) in;
layout(set=1,binding=0) uniform samplerCube coneEnvironmentMap;
layout(std430,set=1,binding=1) writeonly buffer EnvironmentColumns { float environmentColumns[]; };
layout(std430,set=1,binding=2) writeonly buffer EnvironmentHarmonics { vec4 environmentHarmonics[]; };
layout(std430,set=1,binding=3) writeonly buffer EnvironmentLuminance { float environmentLuminance[]; };
shared vec3 groupHarmonics[64][ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS];
vec3 TexelRadiance(uint face, int x, int y)
{
    // The sampled luminance surface is bilinear within each face and clamped at its edges.
    ivec2 texel = clamp(ivec2(x, y), ivec2(0), ivec2(int(ZEN_ENVIRONMENT_IMPORTANCE_SIZE) - 1));
    vec2 uv = (vec2(texel) + 0.5) * (2.0 / float(ZEN_ENVIRONMENT_IMPORTANCE_SIZE)) - 1.0;
    return textureLod(coneEnvironmentMap, EnvironmentCubeDirection(face, uv), 0).rgb;
}
float TexelLuminance(uint face, int x, int y)
{
    return max(dot(TexelRadiance(face, x, y), vec3(0.2126, 0.7152, 0.0722)), 0.0);
}
void main()
{
    uint row = gl_GlobalInvocationID.x;
    vec3 harmonics[ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS];
    for(uint k = 0u; k < ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS; ++k) harmonics[k] = vec3(0);
    if(row < ZEN_ENVIRONMENT_IMPORTANCE_ROWS)
    {
        uint face = row / ZEN_ENVIRONMENT_IMPORTANCE_SIZE;
        int y = int(row % ZEN_ENVIRONMENT_IMPORTANCE_SIZE);
        uint offset = row * (ZEN_ENVIRONMENT_IMPORTANCE_SIZE + 1u);
        float sum = 0.0;
        environmentColumns[offset] = 0.0;
        // Texel solid angle is the face-area element times the cube Jacobian.
        float texelArea = 4.0 / float(ZEN_ENVIRONMENT_IMPORTANCE_SIZE * ZEN_ENVIRONMENT_IMPORTANCE_SIZE);
        // Columns x-1, x and x+1 of rows y-1, y and y+1.
        vec3 left = vec3(TexelLuminance(face, -1, y - 1), TexelLuminance(face, -1, y), TexelLuminance(face, -1, y + 1));
        vec3 center = vec3(TexelLuminance(face, 0, y - 1), TexelLuminance(face, 0, y), TexelLuminance(face, 0, y + 1));
        for(uint x = 0u; x < ZEN_ENVIRONMENT_IMPORTANCE_SIZE; ++x)
        {
            int next = int(x) + 1;
            vec3 right = vec3(TexelLuminance(face, next, y - 1), TexelLuminance(face, next, y), TexelLuminance(face, next, y + 1));
            vec2 uv = (vec2(x, y) + 0.5) * (2.0 / float(ZEN_ENVIRONMENT_IMPORTANCE_SIZE)) - 1.0;
            vec3 direction = EnvironmentCubeDirection(face, uv);
            vec3 radiance = TexelRadiance(face, int(x), y);
            float jacobian = EnvironmentCubeJacobian(uv);
            // Texels are drawn by the mean of the bilinear luminance over their area, which the
            // sampler then follows within the texel (EnvironmentTexelMean).
            float mean = 9.0 / 16.0 * center.y + 3.0 / 32.0 * (center.x + center.z + left.y + right.y)
                + 1.0 / 64.0 * (left.x + left.z + right.x + right.z);
            sum += mean * jacobian;
            environmentColumns[offset + x + 1u] = sum;
            environmentLuminance[row * ZEN_ENVIRONMENT_IMPORTANCE_SIZE + x] = center.y;
            float basis[ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS];
            EnvironmentHarmonicBasis(direction, basis);
            for(uint k = 0u; k < ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS; ++k)
                harmonics[k] += radiance * (basis[k] * jacobian * texelArea);
            left = center;
            center = right;
        }
    }
    for(uint k = 0u; k < ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS; ++k)
        groupHarmonics[gl_LocalInvocationID.x][k] = harmonics[k];
    barrier();
    if(gl_LocalInvocationID.x < ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS)
    {
        vec3 total = vec3(0);
        for(uint i = 0u; i < 64u; ++i) total += groupHarmonics[i][gl_LocalInvocationID.x];
        environmentHarmonics[gl_WorkGroupID.x * ZEN_ENVIRONMENT_HARMONIC_COEFFICIENTS + gl_LocalInvocationID.x] = vec4(total, 0);
    }
}
