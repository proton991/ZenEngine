#version 450
#extension GL_GOOGLE_include_directive : require
#include "filter_common.glsl"
#include "../../SceneRenderer/surface_lookup.glsl"
layout(local_size_x=GI_QUERY_GROUP_SIZE) in;
layout(set=1,binding=0) uniform sampler2D positionMap;
layout(set=1,binding=1) uniform sampler2D normalMap;
layout(set=1,binding=2) uniform sampler2D geometricNormalMap;
layout(set=1,binding=3) uniform usampler2D receiverMap;
layout(set=1,binding=4) uniform sampler2D depthMap;
layout(set=3,binding=2,std430) buffer SelectionTaps { uint taps[]; };
void main() {
    uint index=StaticItem();
    // Upscaling repeats source texels. Visit each once; downscaled axes retain
    // the exact composition lookup, including mixed and noninteger extents.
    ivec2 extent=textureSize(positionMap,0);
    uvec2 selectionExtent=min(surfaceExtent.xy,uvec2(extent));
    if(index<selectionExtent.x*selectionExtent.y) {
        uvec2 pixel=uvec2(index%selectionExtent.x,index/selectionExtent.x);
        ivec2 texel=SurfaceTexel(pixel,selectionExtent,extent);
        vec4 position=texelFetch(positionMap,texel,0);
        uvec2 identity=texelFetch(receiverMap,texel,0).rg;
        if(identity.y==GI_STATIC && ValidSurface(texelFetch(depthMap,texel,0).r,identity,position,
            texelFetch(normalMap,texel,0),texelFetch(geometricNormalMap,texel,0))) {
            vec3 grid=(position.xyz-staticGI.minimumCellSize.xyz)/staticGI.minimumCellSize.w;
            if(all(greaterThanEqual(grid,vec3(0))) && all(lessThanEqual(grid,vec3(staticGI.volume.x)))) {
                ivec3 base=ivec3(floor(grid-0.5));
                // The receiver-list buffer is scratch until compaction. Its
                // reset sentinel is UINT_MAX; mark the eight trilinear taps once.
                // A cell pass expands padding/filter support independently of
                // how many screen pixels sample the same voxel neighborhood.
                for(int x=0;x<=1;++x) for(int y=0;y<=1;++y) for(int z=0;z<=1;++z) {
                    ivec3 p=base+ivec3(x,y,z);
                    if(all(greaterThanEqual(p,ivec3(0))) && all(lessThan(p,ivec3(staticGI.volume.x))))
                        atomicAnd(taps[StaticCellID(p)],0u);
                }
            }
        }
    }
}
