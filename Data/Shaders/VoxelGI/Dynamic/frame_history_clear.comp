#version 450
#extension GL_GOOGLE_include_directive : require
#include "frame_common.glsl"
layout(local_size_x=GI_QUERY_GROUP_SIZE) in;
layout(set=3,binding=1,std430) writeonly buffer HistoryMetadata { uvec4 metadata[]; };
void main() {
    uint cell=StaticItem(),n=staticGI.volume.x;
    if(cell<n*n*n) metadata[cell]=uvec4(GI_INVALID_CELL,0,0,0);
}
