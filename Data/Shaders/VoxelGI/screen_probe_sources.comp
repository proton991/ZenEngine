#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "../Common/opacity_micromap.glsl"
#include "screen_probe_sources.glsl"
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (HybridInView(pixel))
    {
        uint visible = 0u;
        if (texelFetch(receiverDepth, pixel, 0).r < 1.0)
        {
            vec3 geometric  = HybridGeometricNormal(pixel);
            uint candidates = SourceCandidates(geometric);
            if (candidates != 0u)
            {
                visible = RefinedSourceVisibility(pixel, HybridPosition(pixel), geometric, candidates);
            }
        }
        imageStore(probeSourceVisibility, pixel, uvec4(visible));
    }
}
