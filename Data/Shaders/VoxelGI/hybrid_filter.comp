#version 450
#extension GL_GOOGLE_include_directive : require
#include "hybrid_guides.glsl"
#include "gi_common.glsl"
layout(set=3,binding=1) uniform sampler3D voxelOpacity;
layout(set=3,binding=2) uniform samplerCube coneEnvironmentMap;
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=6) uniform sampler2D inputSky;
layout(set=1,binding=7) uniform sampler2D inputSpecular;
layout(set=1,binding=8) uniform sampler2D moments;
layout(set=1,binding=9) uniform sampler2D historyLength;
layout(set=1,binding=10,rgba16f) uniform writeonly image2D filteredSky;
layout(set=1,binding=11,rgba16f) uniform writeonly image2D filteredSpecular;
layout(set=1,binding=12) uniform sampler2D inputVariance;
layout(set=1,binding=13,rgba32f) uniform writeonly image2D filteredVariance;
// Unoccluded irradiance guide from the temporal pass (hybrid_sky_guide.glsl).
layout(set=1,binding=14) uniform sampler2D skyGuide;
layout(set=1,binding=15) uniform sampler2D inputBounce;
layout(set=1,binding=16) uniform sampler2D bounceMoments;
layout(set=1,binding=17) uniform sampler2D bounceHistory;
layout(set=1,binding=18,rgba16f) uniform writeonly image2D filteredBounce;
layout(push_constant) uniform FilterConstants { uint stepWidth; } atrous;
// Bounce inputs are 1x1 placeholders unless ray-hit bounce is selected.
vec4 Bounce(ivec2 p) { return hybrid.bounce.x!=0u ? texelFetch(inputBounce,p,0) : vec4(0); }
float BounceLength(ivec2 p) { return hybrid.bounce.x!=0u ? texelFetch(bounceHistory,p,0).a : 0.0; }
vec3 ReadVariance(ivec2 p)
{
    vec4 m=texelFetch(moments,p,0);
    vec2 b=hybrid.bounce.x!=0u ? texelFetch(bounceMoments,p,0).rg : vec2(0);
    vec3 v=max(vec3(m.g-m.r*m.r,m.a-m.b*m.b,b.y-b.x*b.x),vec3(0));
    vec3 lengths=vec3(texelFetch(historyLength,p,0).rg,BounceLength(p));
    return atrous.stepWidth==1u ? v/max(lengths,vec3(1)) : texelFetch(inputVariance,p,0).rgb;
}
vec3 SkyGuide(ivec2 p) { return texelFetch(skyGuide,p,0).rgb; }
bool OccupiedStart(ivec2 p)
{
    if(hybrid.provider.x!=0u) return false;
    vec3 uv=WorldToVoxelUV(TraceOrigin(HybridPosition(p),HybridGeometricNormal(p)));
    return InsideVoxelVolume(uv) && texelFetch(voxelOpacity,ivec3(floor(uv*gi.volume.x)),0).a>0.5;
}
void main()
{
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(!HybridInView(p)) return;
    vec4 center=texelFetch(inputSky,p,0), centerSpec=texelFetch(inputSpecular,p,0);
    vec4 centerBounce=Bounce(p);
    uint identity=texelFetch(receiverSurface,p,0).g;
    vec3 position=HybridPosition(p), normal=HybridNormal(p), geometric=HybridGeometricNormal(p);
    vec3 guide=SkyGuide(p);
    // Sky luminance and its variance are compared as ratios to the guide luminance.
    vec3 scale=vec3(1.0/HybridLuminance(guide),1.0,1.0);
    vec3 mean=vec3(0), second=vec3(0); float count=0.0;
    // A local variance estimate is also used during the first four frames.
    for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x)
    {
        ivec2 q=p+ivec2(x,y)*int(atrous.stepWidth);
        if(!HybridInView(q) || texelFetch(receiverSurface,q,0).g!=identity) continue;
        vec3 value=vec3(HybridLuminance(texelFetch(inputSky,q,0).rgb)/HybridLuminance(SkyGuide(q)),texelFetch(inputSpecular,q,0).a,
                        HybridLuminance(Bounce(q).rgb));
        mean+=value; second+=value*value; count+=1.0;
    }
    mean/=max(count,1.0); second/=max(count,1.0);
    vec3 lengths=vec3(texelFetch(historyLength,p,0).rg,BounceLength(p));
    vec3 variance=ReadVariance(p)*scale*scale;
    if(atrous.stepWidth==1u)
        variance=mix(variance,max(second-mean*mean,vec3(0)),lessThan(lengths,vec3(4)));
    const float kernel[5]=float[5](1,4,6,4,1);
    vec4 sky=vec4(0), spec=vec4(0); vec3 total=vec3(0), varianceOut=vec3(0), bounce=vec3(0);
    vec3 centerValue=vec3(HybridLuminance(center.rgb)*scale.x,centerSpec.a,HybridLuminance(centerBounce.rgb));
    bool occupiedStart=OccupiedStart(p);
    for(int y=-2;y<=2;++y) for(int x=-2;x<=2;++x)
    {
        ivec2 q=p+ivec2(x,y)*int(atrous.stepWidth);
        if(!HybridInView(q) || texelFetch(receiverSurface,q,0).g!=identity) continue;
        // Preserve exact D2 start-cell occlusion; filtering it away leaks at wall bases.
        if(occupiedStart!=OccupiedStart(q)) continue;
        vec3 delta=HybridPosition(q)-position;
        float plane=abs(dot(delta,geometric));
        if(plane>hybrid.rejection.x*max(1.0,length(delta))) continue;
        float normalWeight=pow(max(dot(normal,HybridNormal(q)),0.0),32.0);
        if(dot(geometric,HybridGeometricNormal(q))<0.9) continue;
        vec4 sampleSky=texelFetch(inputSky,q,0), sampleSpec=texelFetch(inputSpecular,q,0);
        vec3 sampleGuide=SkyGuide(q);
        vec3 sampleBounce=Bounce(q).rgb;
        vec3 sampleScale=vec3(1.0/HybridLuminance(sampleGuide),1.0,1.0);
        vec3 difference=abs(vec3(HybridLuminance(sampleSky.rgb)*sampleScale.x,sampleSpec.a,HybridLuminance(sampleBounce))-centerValue);
        vec3 neighborVariance=ReadVariance(q)*sampleScale*sampleScale;
        // Diffuse lighting must preserve the sharp visibility edges of small HDR sources.
        vec3 sigma=vec3(1.0,4.0,4.0)*sqrt(max(variance+neighborVariance,vec3(0)))+vec3(1e-4)*scale;
        vec3 w=kernel[x+2]*kernel[y+2]*normalWeight*exp(-difference/sigma);
        varianceOut+=w*w*neighborVariance;
        sky+=w.x*vec4(sampleSky.rgb/sampleGuide,sampleSky.a); spec+=w.y*sampleSpec; total+=w;
        bounce+=w.z*sampleBounce;
    }
    imageStore(filteredVariance,p,vec4(varianceOut/max(total*total,vec3(1e-20))/(scale*scale),0));
    imageStore(filteredSky,p,total.x>0.0 ? vec4(sky.rgb*guide,sky.a)/total.x : center);
    imageStore(filteredSpecular,p,total.y>0.0 ? spec/total.y : centerSpec);
    if(hybrid.bounce.x!=0u)
        imageStore(filteredBounce,p,vec4(total.z>0.0 ? bounce/total.z : centerBounce.rgb,centerBounce.a));
}
