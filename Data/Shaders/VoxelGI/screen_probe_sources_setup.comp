#version 460
#extension GL_GOOGLE_include_directive : require
#include "gi_common.glsl"
#include "environment_sampling.glsl"
// Per source tile: direction (w = 1 when the tile can be drawn), then energy (radiance times solid angle).
layout(std430, set = 1, binding = 131) writeonly buffer ScreenProbeSourceLights
{
    vec4 sourceLights[];
};
layout(local_size_x = ZEN_ENVIRONMENT_MAX_SOURCES) in;
// Resolve each source tile once per frame; the per-pixel passes only read the result.
void main()
{
    uint  source    = gl_LocalInvocationIndex;
    vec4  direction = vec4(0);
    vec3  energy    = vec3(0);
    float scale     = sceneUbo.environment.x * sceneUbo.environment.z * gi.lighting.y;
    if (source < environmentSourceCount && scale > 0.0)
    {
        // Only the direction comes from this sample. The tile has positive integrated energy
        // even when the median lands exactly on a zero-density boundary.
        float unusedPdf;
        direction = vec4(SampleEnvironmentTile(environmentSourceTiles[source], vec2(.5), unusedPdf), 1.0);
        energy =
            vec3(environmentSourceEnergy[source][0], environmentSourceEnergy[source][1], environmentSourceEnergy[source][2])
            * scale;
    }
    sourceLights[2u * source]      = direction;
    sourceLights[2u * source + 1u] = vec4(energy, 0);
}
