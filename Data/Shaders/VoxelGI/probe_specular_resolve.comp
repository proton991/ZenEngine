#version 450
#extension GL_GOOGLE_include_directive : require
#include "probe_specular_resolve.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 7, binding = 8, rgba16f) uniform writeonly image2D probeRawSpecular;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (HybridInView(pixel))
    {
        imageStore(probeRawSpecular, pixel, ProbeResolveSpecular(pixel, ProbeLoadReceiver(pixel)));
    }
}
