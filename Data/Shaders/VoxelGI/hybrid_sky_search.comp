#version 450
#extension GL_GOOGLE_include_directive : require
#include "hybrid_filter_common.glsl"
#include "hybrid_sky_support_bounds.glsl"
layout(local_size_x=256) in;
layout(set=1,binding=10,rgba16f) uniform image2D filteredSky;
layout(set=1,binding=13,rgba32f) uniform image2D filteredVariance;
layout(std430,set=1,binding=21) readonly buffer HybridSkySearchArgs { uint searchCount; uint searchX; uint searchY; uint searchZ; };
layout(std430,set=1,binding=22) readonly buffer HybridSkySearchPixels { uint searchPixels[]; };
shared uint tileSupport[81];
shared vec4 partialSky[256];
shared vec2 partialWeightVariance[256];
void main()
{
    uint index=gl_WorkGroupID.y*65535u+gl_WorkGroupID.x;
    if(index>=searchCount) return;
    uint width=uint(textureSize(inputSky,0).x), pixel=searchPixels[index];
    ivec2 p=ivec2(pixel%width,pixel/width);
    uint lane=gl_LocalInvocationIndex, identity=texelFetch(receiverSurface,p,0).g;
    vec4 center=texelFetch(inputSky,p,0);
    vec3 position=FilterPosition(p), normal=HybridNormal(p), geometric=HybridGeometricNormal(p), guide=SkyGuide(p);
    float scale=1.0/HybridLuminance(guide);
    float variance=texelFetch(inputVariance,p,0).x*scale*scale;
    ivec2 tileOrigin=max(p-32,ivec2(0))/8;
    if(lane<81u)
    {
        ivec2 tile=tileOrigin+ivec2(lane%9u,lane/9u);
        uint mask=SkySupportMask(geometric);
        tileSupport[lane]=all(lessThan(tile,textureSize(skySupport,0)))
            && TileHasSkySupport(tile,mask,geometric,position) ? 1u : 0u;
    }
    barrier();
    vec4 sky=vec4(0); float total=0.0, varianceOut=0.0;
    for(uint tap=lane;tap<65u*65u;tap+=256u)
    {
        ivec2 offset=ivec2(tap%65u,tap/65u)-32, q=p+offset;
        float weight=SurfaceWeight(q,identity,position,normal,geometric);
        if(weight==0.0) continue;
        vec3 sampleGuide=texelFetch(skyGuide,q,0).rgb;
        ivec2 tile=q/8-tileOrigin;
        if(tileSupport[tile.y*9+tile.x]==0u)
        {
            // Compatible taps in this tile have zero sky and variance. They
            // still contribute the original spatial/surface weight to the denominator.
            total+=weight*exp(-float(offset.x*offset.x+offset.y*offset.y)/512.0);
            continue;
        }
        vec4 sampleSky=texelFetch(inputSky,q,0);
        float sampleScale=1.0/HybridLuminance(sampleGuide);
        float neighborVariance=texelFetch(inputVariance,q,0).x*sampleScale*sampleScale;
        float sigma=1.5*sqrt(max(variance+neighborVariance,0.0))+1e-4*scale;
        weight*=exp(-float(offset.x*offset.x+offset.y*offset.y)/512.0)
            *SkyWeight(sampleSky.rgb,sampleGuide,center.rgb,guide,sigma);
        sky+=weight*vec4(sampleSky.rgb/sampleGuide,sampleSky.a);
        total+=weight;
        varianceOut+=weight*weight*neighborVariance;
    }
    partialSky[lane]=sky;
    partialWeightVariance[lane]=vec2(total,varianceOut);
    barrier();
    for(uint stride=128u;stride>0u;stride/=2u)
    {
        if(lane<stride)
        {
            partialSky[lane]+=partialSky[lane+stride];
            partialWeightVariance[lane]+=partialWeightVariance[lane+stride];
        }
        barrier();
    }
    if(lane==0u)
    {
        total=partialWeightVariance[0].x;
        vec4 filtered=imageLoad(filteredVariance,p);
        filtered.x=partialWeightVariance[0].y/max(total*total,1e-20)/(scale*scale);
        imageStore(filteredVariance,p,filtered);
        imageStore(filteredSky,p,total>0.0 ? vec4(partialSky[0].rgb*guide,partialSky[0].a)/total : center);
    }
}
