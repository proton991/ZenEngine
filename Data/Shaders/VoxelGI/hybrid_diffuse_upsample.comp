#version 450
#extension GL_GOOGLE_include_directive : require
#include "hybrid_guides.glsl"
// Reconstructs full-resolution raw diffuse from the half-resolution leaders (hybrid_trace_half.comp).
// Each receiver averages the leaders of the surrounding 3x3 blocks that lie on its surface, with
// a tent weight on their pixel distance and the spatial filter's shading-normal weight. Sky is
// transferred as a ratio to each receiver's normal-dependent guide, as the spatial filter does,
// so normal-mapped neighbours keep their own orientation's sky. Leaders
// rotate every frame, so temporal accumulation gathers a receiver's own samples as well as its
// neighbours'. A receiver whose previous sky differs from every nearby leader's (a visibility edge,
// or lit next to dark) is listed for full-resolution rays.
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=6) uniform sampler2D halfSky;
layout(set=1,binding=7) uniform sampler2D halfBounce;
layout(set=1,binding=8) uniform sampler2D halfBouncePrevious;
layout(set=1,binding=9) uniform sampler2D halfGuide;
layout(set=1,binding=10) uniform sampler2D previousSkyMoments;
layout(set=1,binding=17) uniform sampler2D previousHistoryLength;
layout(set=1,binding=11,rgba16f) uniform writeonly image2D rawSky;
layout(set=1,binding=12,rgba16f) uniform writeonly image2D rawBounce;
layout(set=1,binding=13,rgba16f) uniform writeonly image2D rawBouncePrevious;
// Every receiver's reconstruction guide, written by the half-resolution pass.
layout(set=1,binding=14) uniform sampler2D skyGuide;
layout(std430,set=1,binding=15) buffer HybridDiffuseFallbackArgs
{ uint fallbackCount; uint fallbackGroupsX; uint fallbackGroupsY; uint fallbackGroupsZ; };
layout(std430,set=1,binding=16) writeonly buffer HybridDiffuseFallbackPixels { uint fallbackPixels[]; };
const ivec2 HALF_PHASES[4]=ivec2[4](ivec2(0,0),ivec2(1,1),ivec2(1,0),ivec2(0,1));
// Blocks are 2x2 pixels, so a 2-pixel tent reaches the nearest leaders of all neighbouring blocks.
const float LEADER_RADIUS=2.0;
void main()
{
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(!HybridInView(p)) return;
    vec4 sky=vec4(0), bounce=vec4(0), previous=vec4(0);
    uint identity=texelFetch(receiverSurface,p,0).g;
    bool fallback=false;
    if(texelFetch(receiverDepth,p,0).r<1.0 && identity!=0u)
    {
        vec2 moments=texelFetch(previousSkyMoments,p,0).rg;
        float mean=moments.x;
        // Variance of the history mean, for the noise allowance below.
        float meanVariance=max(moments.y-mean*mean,0.0)/max(texelFetch(previousHistoryLength,p,0).r,1.0);
        vec3 position=HybridPosition(p), n=HybridNormal(p), ng=HybridGeometricNormal(p);
        ivec2 halfSize=textureSize(halfGuide,0), block=p/2;
        float total=0.0;
        for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x)
        {
            ivec2 b=block+ivec2(x,y);
            if(any(lessThan(b,ivec2(0))) || any(greaterThanEqual(b,halfSize))) continue;
            vec4 leaderGuide=texelFetch(halfGuide,b,0);
            if(leaderGuide.a<0.0) continue;
            ivec2 q=b*2+HALF_PHASES[int(leaderGuide.a)];
            float weight=max(1.0-length(vec2(q-p))/LEADER_RADIUS,0.0);
            if(weight<=0.0 || texelFetch(receiverSurface,q,0).g!=identity) continue;
            // The same plane and a similar orientation (normal maps vary per pixel; nearer
            // normals dominate as in the spatial filter).
            vec3 delta=HybridPosition(q)-position;
            float shading=dot(n,HybridNormal(q));
            if(abs(dot(ng,delta))>hybrid.rejection.x*max(1.0,length(delta))
                || shading<0.9 || dot(ng,HybridGeometricNormal(q))<0.99) continue;
            // A similar previous sky: both dark, or both lit and within 25% or three standard
            // errors of their history means. Visibility edges (contact shadows, openings) between
            // them must not be averaged away.
            vec2 otherMoments=texelFetch(previousSkyMoments,q,0).rg;
            float other=otherMoments.x;
            float otherVariance=max(otherMoments.y-other*other,0.0)
                /max(texelFetch(previousHistoryLength,q,0).r,1.0);
            bool dark=!(mean>0.0) && !(other>0.0);
            bool lit=mean>0.0 && other>0.0 && abs(other-mean)<=max(0.25*max(mean,other),
                3.0*sqrt(meanVariance+otherVariance));
            if(!dark && !lit) continue;
            weight*=pow(shading,32.0);
            vec4 leaderSky=texelFetch(halfSky,b,0);
            sky+=weight*vec4(leaderSky.rgb/leaderGuide.rgb,leaderSky.a);
            if(hybrid.bounce.x!=0u)
            {
                bounce+=weight*texelFetch(halfBounce,b,0);
                previous+=weight*texelFetch(halfBouncePrevious,b,0);
            }
            total+=weight;
        }
        fallback=total<=0.0;
        if(fallback)
            sky=bounce=previous=vec4(0);
        else
        {
            sky/=total; bounce/=total; previous/=total;
            sky.rgb*=texelFetch(skyGuide,p,0).rgb;
        }
    }
    // Listed receivers are overwritten by the fallback pass.
    imageStore(rawSky,p,sky);
    if(hybrid.bounce.x!=0u)
    {
        imageStore(rawBounce,p,bounce);
        imageStore(rawBouncePrevious,p,previous);
    }
    if(fallback)
    {
        // One frame-wide list, so the fallback pass runs full warps however sparse it is.
        uint index=atomicAdd(fallbackCount,1u);
        fallbackPixels[index]=uint(p.y)*uint(textureSize(receiverDepth,0).x)+uint(p.x);
        atomicMax(fallbackGroupsX,index/64u+1u);
    }
}
