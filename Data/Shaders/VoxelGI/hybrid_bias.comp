#version 450
#extension GL_GOOGLE_include_directive : require
#include "hybrid_guides.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=6) uniform sampler2D temporalSky;
layout(set=1,binding=7) uniform sampler2D filteredSky;
layout(set=1,binding=8) uniform sampler2D skyGuide;
layout(set=1,binding=9) uniform sampler2D inputCorrection;
layout(set=1,binding=10,rgba32f) uniform writeonly image2D outputSky;
// Zero initializes the demodulated residual; 1..16 blur it; 32 remodulates and adds it.
layout(push_constant) uniform BiasConstants { uint stepWidth; } bias;
void main()
{
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(!HybridInView(p)) return;
    vec4 filtered=texelFetch(filteredSky,p,0);
    vec3 guide=texelFetch(skyGuide,p,0).rgb;
    vec3 value=vec3(0);
    uint identity=texelFetch(receiverSurface,p,0).g;
    if(bias.stepWidth==0u)
        value=(texelFetch(temporalSky,p,0).rgb-filtered.rgb)/guide;
    else if(bias.stepWidth==32u)
    {
        // A coarse residual must not erase a resolved positive shadow-edge sample.
        // Limit only its negative correction; positive energy recovery is unchanged.
        vec3 correction=max(texelFetch(inputCorrection,p,0).rgb*guide,-0.9*filtered.rgb);
        value=filtered.rgb+correction;
    }
    else if(identity!=0u)
    {
        vec3 position=HybridPosition(p), geometric=HybridGeometricNormal(p);
        const float kernel[5]=float[5](1,4,6,4,1);
        float total=0.0;
        for(int y=-2;y<=2;++y) for(int x=-2;x<=2;++x)
        {
            ivec2 q=p+ivec2(x,y)*int(bias.stepWidth);
            if(!HybridInView(q) || texelFetch(receiverSurface,q,0).g!=identity) continue;
            vec3 delta=HybridPosition(q)-position;
            // Symmetric plane tests avoid transferring energy across a corner or thin wall.
            if(max(abs(dot(delta,geometric)),abs(dot(delta,HybridGeometricNormal(q))))>hybrid.rejection.x) continue;
            float weight=kernel[x+2]*kernel[y+2];
            value+=texelFetch(inputCorrection,q,0).rgb*weight;
            total+=weight;
        }
        value/=max(total,1.0);
    }
    imageStore(outputSky,p,vec4(value,filtered.a));
}
