#version 450
#extension GL_GOOGLE_include_directive : require
#include "Graphics/Shared/VoxelGI.h"
layout(local_size_x=ZEN_VOXEL_VOLUME_GROUP_SIZE, local_size_x_id=ZEN_VOXEL_VOLUME_GROUP_X_ID,
       local_size_y=ZEN_VOXEL_VOLUME_GROUP_SIZE, local_size_y_id=ZEN_VOXEL_VOLUME_GROUP_Y_ID,
       local_size_z=ZEN_VOXEL_VOLUME_GROUP_SIZE, local_size_z_id=ZEN_VOXEL_VOLUME_GROUP_Z_ID) in;
layout(set=1,binding=0,std430) readonly buffer ReflectanceSums { uvec4 sums[]; };
layout(set=1,binding=1) uniform sampler3D voxelReflectance;
layout(set=1,binding=2,std430) writeonly buffer ReflectanceCapture { uint words[]; };
layout(set=1,binding=3) uniform sampler3D voxelRadiance;
layout(push_constant) uniform Constants { uint hasRadiance; } pc;
void main()
{
    ivec3 p=ivec3(gl_GlobalInvocationID);
    ivec3 size=textureSize(voxelReflectance,0);
    if(any(greaterThanEqual(p,size))) return;
    uint cell=uint(p.x+size.x*(p.y+size.y*p.z));
    for(uint channel=0;channel<4;++channel) words[cell*8+channel]=sums[cell][channel];
    words[cell*8+4]=packUnorm4x8(texelFetch(voxelReflectance,p,0));
    vec3 radiance=pc.hasRadiance!=0u ? texelFetch(voxelRadiance,p,0).rgb : vec3(0);
    for(uint channel=0;channel<3;++channel) words[cell*8+5+channel]=floatBitsToUint(radiance[channel]);
}
