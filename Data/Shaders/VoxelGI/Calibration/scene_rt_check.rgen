#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#include "../../Common/ray_pipeline.glsl"
#include "../gi_common.glsl"
#include "../scene_ray_inputs.glsl"
layout(std430, set = 1, binding = 0) writeonly buffer Results
{
    vec4 values[];
};
layout(push_constant) uniform QueryConstants
{
    vec4 worldOffset;
}
query;
layout(location = 0) rayPayloadEXT vec4 result;
void main()
{
    uint index  = gl_LaunchIDEXT.x;
    vec3 origin = vec3(float(index) * 2.0, 0, -1) + query.worldOffset.xyz;
    result      = vec4(-1.0, float(0xffffffffu), float(0xffffffffu), float(rayScene.generation.x));
    ZenTraceRay(sceneAccelerationStructure, 0u, 0xffu, 0u, 0u, 0u, origin, 0.0, vec3(0, 0, 1), 100.0, 0);
    values[index] = result;
}
