#version 460
#extension GL_GOOGLE_include_directive : require
#include "../hybrid_sampling.glsl"
#include "../restir_target.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 1, binding = 0) writeonly buffer Results
{
    vec4 results[];
};
void main()
{
    uint  index     = gl_GlobalInvocationID.x;
    float nv        = 0.2 + 0.8 * float(index % 4u) / 3.0;
    float roughness = 0.3 + 0.7 * float(index / 4u) / 3.0;
    vec3  view      = vec3(sqrt(max(1.0 - nv * nv, 0.0)), 0, nv);
    float integral  = 0.0;
    // Independent uniform-solid-angle quadrature, unlike the LUT's VNDF quadrature.
    const uint count = 65536u;
    for (uint i = 0u; i < count; ++i)
    {
        vec2 u =
            fract(vec2((float(i) + 0.5) / float(count), float(bitfieldReverse(i)) * 2.3283064365386963e-10) + vec2(0.31, 0.73));
        float sine = sqrt(1.0 - u.x * u.x), phi = 2.0 * HYBRID_PI * u.y;
        vec3  direction  = vec3(sine * cos(phi), sine * sin(phi), u.x);
        integral        += GISpecularDensity(vec3(0, 0, 1), view, direction, roughness) * (2.0 * HYBRID_PI);
    }
    results[index] = vec4(integral / float(count), GILobeIntegral(nv, roughness), nv, roughness);
}
