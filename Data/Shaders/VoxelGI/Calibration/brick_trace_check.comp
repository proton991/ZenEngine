#version 450
#extension GL_GOOGLE_include_directive : require
// Reuse the production tracer without requiring software or hardware triangle traversal bindings.
#define HYBRID_BRICK_TRAVERSAL
#define HYBRID_VOXEL_REFERENCE
#include "../hybrid_provider.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 1, binding = 0) readonly buffer Rays
{
    vec4 rays[]; // origin, maximum distance; normalized direction, unused
};
layout(std430, set = 1, binding = 1) writeonly buffer Results
{
    vec4 values[]; // hit position, hit flag; entered normal, distance
};
void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (2u * index < rays.length())
    {
        vec4            start   = rays[2u * index];
        HybridRayResult hit     = BrickTraceRay(start.xyz, rays[2u * index + 1u].xyz, start.w);
        values[2u * index]      = vec4(hit.position, hit.hit ? 1.0 : 0.0);
        values[2u * index + 1u] = vec4(hit.normal, length(hit.position - start.xyz));
    }
}
