#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "../../Common/opacity_micromap.glsl"
#define HYBRID_HARDWARE_PROVIDER
#include "../hybrid_provider.glsl"
#include "../../ShadowMapping/light_occluders.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 1, binding = 0) writeonly buffer Results
{
    uvec4 results[];
};
void main()
{
    uint       index     = gl_GlobalInvocationID.x;
    vec2       xy        = (vec2(index % 32u, (index / 32u) % 32u) + 0.5) / 32.0 * 4.0 - 2.0;
    float      z[]       = float[](0.25, 0.5, 1.0, 2.0);
    vec3       position  = vec3(xy, z[index / 1024u]);
    SceneLight light     = sceneUbo.lights[0];
    bool       cached    = CachedLightOccluded(0, position, vec3(0, 0, -1), light);
    bool       reference = HardwareLightVisibility(position, vec3(0, 0, -1), light) == 0.0;
    results[index]       = uvec4(uint(cached), uint(reference), uint(cached && !reference), 0);
}
