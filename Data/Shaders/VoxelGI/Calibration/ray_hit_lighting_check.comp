#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#include "../../Common/opacity_micromap.glsl"
#define HYBRID_HARDWARE_PROVIDER
#include "../hybrid_provider.glsl"
#include "../hit_radiance.glsl"
layout(set = 1, binding = 7) uniform samplerCube coneEnvironmentMap;
#include "../ray_hit_lighting.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 1, binding = 0) writeonly buffer Results
{
    vec4 values[];
};
void main()
{
    uint            index = gl_GlobalInvocationID.x;
    HybridRayResult hit   = HardwareTraceRay(vec3(float(index) * 2.0, 0, 0.25), vec3(0, 0, -1), 1.0, true);
    values[index]         = hit.hit ? vec4(HardwareHitRadiance(hit, HybridHash(index)), float(hit.triangle.z)) : vec4(-1);
}
