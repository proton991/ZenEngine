#version 460
#extension GL_GOOGLE_include_directive : require
#define HYBRID_FIELD_TRAVERSAL
#include "../hybrid_provider.glsl"
layout(local_size_x = 1) in;
layout(set = 1, binding = 0) uniform sampler3D testedSky;
layout(std140, set = 1, binding = 1) uniform uFieldLightingCheck
{
    vec4 lightPosition;
};
layout(std430, set = 1, binding = 2) writeonly buffer FieldLightingResults
{
    vec4 values[];
};
void main()
{
    HybridRayResult receiver = HybridRayResult(true, vec3(0), vec3(1, 0, 0), ivec3(0), true);
    HybridRayResult outside  = FieldTraceRay(FieldTraceOrigin(vec3(0), vec3(1, 0, 0)), vec3(1, 0, 0), 10.0, true);
    values[0]                = texelFetch(testedSky, ivec3(0), 0);
    values[1]                = vec4(FieldLightVisibility(receiver, lightPosition.xyz), float(outside.hit), float(outside.valid),
                                    float(outside.cell.x));
    values[2]                = vec4(FieldLightVisibility(receiver, vec3(-10, 0, 0)));
}
