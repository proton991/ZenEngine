#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_opacity_micromap_ray_query_mode : require
const bool gl_EnableOpacityMicromapEXT = true;
layout(local_size_x = 1) in;
layout(set = 1, binding = 0) uniform accelerationStructureEXT testScene;
layout(std430, set = 1, binding = 1) writeonly buffer Results
{
    vec4 values[];
};
void main()
{
    uint        index = gl_GlobalInvocationID.x;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, testScene, 0u, 0xffu, vec3(float(index / 2u) * 2.0, 0, -1), 0.0, vec3(0, 0, 1), 10.0);
    uint candidates = 0u;
    while (rayQueryProceedEXT(query))
    {
        ++candidates;
        if ((index & 1u) == 0u)
        {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    bool hit      = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
    values[index] = vec4(hit ? rayQueryGetIntersectionTEXT(query, true) : -1.0, float(candidates), 0, 0);
}
