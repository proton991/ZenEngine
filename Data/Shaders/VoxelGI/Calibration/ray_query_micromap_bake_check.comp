#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_opacity_micromap_ray_query_mode : require
#include "../../Common/material.glsl"
const bool gl_EnableOpacityMicromapEXT = true;
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform accelerationStructureEXT testScene;
layout(std430, set = 1, binding = 1) writeonly buffer Results
{
    vec4 values[];
};
layout(std140, set = 1, binding = 2) readonly buffer MaterialBuffer
{
    Material materials[];
};
bool Covered(vec2 barycentric)
{
    Material         material     = materials[0];
    bool             specular     = material.surfaceProperties.w > 0.5;
    TextureTransform transform    = specular ? material.featureTextures[2].transform : material.textureTransforms[0];
    int              textureIndex = specular ? int(material.featureTextures[2].properties.x) : material.bcTexIndex;
    vec2             uv    = vec2(dot(transform.row0.xyz, vec3(barycentric, 1)), dot(transform.row1.xyz, vec3(barycentric, 1)));
    float            alpha = barycentric.x * (specular ? material.diffuseFactor.a : material.baseColorFactor.a);
    if (textureIndex >= 0)
    {
        alpha *= MaterialBindingTextureLod0(textureIndex, transform, material.textureSampling.xy, uv).a;
    }
    return MaterialOccludes(material, alpha);
}
void main()
{
    uvec2 pixel  = gl_GlobalInvocationID.xy;
    vec2  point  = (vec2(pixel) + vec2(0.25)) / 128.0;
    vec4  result = vec4(0);
    if (pixel.x + pixel.y < 128u)
    {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, testScene, 0u, 0xffu, vec3(point, -1), 0.0, vec3(0, 0, 1), 10.0);
        uint candidates = 0u;
        while (rayQueryProceedEXT(query))
        {
            ++candidates;
            if (Covered(rayQueryGetIntersectionBarycentricsEXT(query, false)))
            {
                rayQueryConfirmIntersectionEXT(query);
            }
        }
        bool hit = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        result   = vec4(hit ? 1.0 : 0.0, Covered(point) ? 1.0 : 0.0, float(candidates), 1.0);
    }
    values[pixel.y * 128u + pixel.x] = result;
}
