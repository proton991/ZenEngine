#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#define HYBRID_HARDWARE_PROVIDER
#define HYBRID_RAY_PIPELINE
#include "../../Common/ray_pipeline.glsl"
#include "../hybrid_sampling.glsl"
#include "../hybrid_provider.glsl"
layout(std430, set = 1, binding = 0) writeonly buffer Results
{
    vec4 values[];
};
void main()
{
    uint index          = gl_LaunchIDEXT.x;
    rayShading          = uvec3(HybridHash(index), 0u, 0u);
    HybridRayResult hit = HardwareTraceRay(vec3(float(index) * 2.0, 0, 0.25), vec3(0, 0, -1), 1.0, true);
    values[index]       = hit.hit ? vec4(hitPayload.radiance, float(hitPayload.material)) : vec4(-1);
    vec3 origin         = vec3(float(index) * 2.0, 0, 0.25);
    values[index + 2u]  = vec4(HardwareOccluded(origin, vec3(0, 0, -1), 1.0), HardwareOccluded(origin, vec3(0, 0, 1), 1e20),
                               HardwareOccluded(origin, vec3(1, 0, 0), 1e20), 1);
}
