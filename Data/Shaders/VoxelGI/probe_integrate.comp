#version 450
#extension GL_GOOGLE_include_directive : require
#include "probe_integrate.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
// Float32: the residual is recovered by subtracting the source sky, which is often much brighter.
layout(set = 7, binding = 4, rgba32f) uniform writeonly image2D probeRawSky;
layout(set = 7, binding = 5, rgba16f) uniform writeonly image2D probeRawBounce;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (HybridInView(pixel))
    {
        vec4 sky, bounce;
        ProbeIntegratePixel(pixel, ProbeLoadReceiver(pixel), sky, bounce);
        imageStore(probeRawSky, pixel, sky);
        imageStore(probeRawBounce, pixel, bounce);
    }
}
