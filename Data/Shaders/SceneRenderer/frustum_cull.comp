#version 450
#extension GL_GOOGLE_include_directive : require
#include "gbuffer_draw.glsl"
#include "Graphics/Shared/SceneCulling.h"

layout(local_size_x = ZEN_SCENE_CULL_GROUP_SIZE) in;

layout(set = 1, binding = 0) uniform uFrustumCull
{
    mat4 projectionView;
};
layout(push_constant) uniform uCullRange
{
    uvec4 drawRange; // First command, command count in this dispatch.
};

// VkDrawIndexedIndirectCommand has a 20-byte array stride.
struct IndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};
layout(std430, set = 1, binding = 1) writeonly buffer IndirectBuffer
{
    IndexedIndirectCommand commands[];
};

#include "../Common/frustum_bounds.glsl"

void main()
{
    uint group      = gl_WorkGroupID.x + gl_NumWorkGroups.x * (gl_WorkGroupID.y + gl_NumWorkGroups.y * gl_WorkGroupID.z);
    uint localIndex = group * ZEN_SCENE_CULL_GROUP_SIZE + gl_LocalInvocationIndex;
    if (localIndex < drawRange.y)
    {
        uint index                 = drawRange.x + localIndex;
        commands[index].indexCount = gbufferDraws[index].geometry.x;
        commands[index].instanceCount =
            IntersectsFrustum(gbufferDraws[index].boundsMin.xyz, gbufferDraws[index].boundsMax.xyz, projectionView) ? 1u : 0u;
        commands[index].firstIndex    = gbufferDraws[index].geometry.y;
        commands[index].vertexOffset  = 0;
        commands[index].firstInstance = index;
    }
}
