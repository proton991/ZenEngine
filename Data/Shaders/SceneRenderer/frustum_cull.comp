#version 450
#extension GL_GOOGLE_include_directive : require
#include "gbuffer_draw.glsl"
#include "Graphics/Shared/SceneCulling.h"

layout(local_size_x = ZEN_SCENE_CULL_GROUP_SIZE) in;

layout(set = 1, binding = 0) uniform uFrustumCull
{
    mat4 projectionView;
};
layout(push_constant) uniform uCullRange
{
    uvec4 drawRange; // First command, command count in this dispatch.
};

// VkDrawIndexedIndirectCommand has a 20-byte array stride.
struct IndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};
layout(std430, set = 1, binding = 1) writeonly buffer IndirectBuffer
{
    IndexedIndirectCommand commands[];
};

bool IntersectsFrustum(vec3 minimum, vec3 maximum)
{
    bool visible = true;
    // Missing/invalid bounds must never hide geometry.
    bool valid = all(lessThanEqual(minimum, maximum)) && !any(isnan(minimum)) && !any(isnan(maximum)) && !any(isinf(minimum))
              && !any(isinf(maximum));
    if (valid)
    {
        mat4 rows = transpose(projectionView);
        // Vulkan clip depth is [0, w]. No perspective divide is needed, so boxes
        // crossing the eye/near plane remain conservative for both camera types.
        vec4 planes[6] =
            vec4[6](rows[3] + rows[0], rows[3] - rows[0], rows[3] + rows[1], rows[3] - rows[1], rows[2], rows[3] - rows[2]);
        for (uint plane = 0; plane < 6; ++plane)
        {
            vec4 p       = planes[plane];
            vec3 support = mix(minimum, maximum, greaterThanEqual(p.xyz, vec3(0.0)));
            // Scale the tolerance by the uncancelled products, including the
            // translation term, to avoid rejecting a box on a clip plane.
            float tolerance = 1e-5 * (dot(abs(p.xyz), abs(support)) + abs(p.w) + 1.0);
            visible         = visible && !(dot(p.xyz, support) + p.w < -tolerance);
        }
    }
    return visible;
}

void main()
{
    uint group      = gl_WorkGroupID.x + gl_NumWorkGroups.x * (gl_WorkGroupID.y + gl_NumWorkGroups.y * gl_WorkGroupID.z);
    uint localIndex = group * ZEN_SCENE_CULL_GROUP_SIZE + gl_LocalInvocationIndex;
    if (localIndex < drawRange.y)
    {
        uint index                 = drawRange.x + localIndex;
        commands[index].indexCount = gbufferDraws[index].geometry.x;
        commands[index].instanceCount =
            IntersectsFrustum(gbufferDraws[index].boundsMin.xyz, gbufferDraws[index].boundsMax.xyz) ? 1u : 0u;
        commands[index].firstIndex    = gbufferDraws[index].geometry.y;
        commands[index].vertexOffset  = 0;
        commands[index].firstInstance = index;
    }
}
